<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a> / Contact us</div>
    <span class="eyebrow">We're all ears</span>
    <h1>Get in touch</h1>
    <p>Questions about an order, a bulk request or just want to say hello? Drop us a message — a real person reads every one.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid-2">
      <div>
        <div class="info-list">
          <div class="info-row">
            <span class="info-icon">📞</span>
            <div><strong>Call or WhatsApp</strong><a href="tel:<%= settings.phone %>"><%= settings.phone %></a></div>
          </div>
          <div class="info-row">
            <span class="info-icon">✉️</span>
            <div><strong>Email us</strong><a href="mailto:<%= settings.email %>"><%= settings.email %></a></div>
          </div>
          <div class="info-row">
            <span class="info-icon">📍</span>
            <div><strong>Kitchen address</strong><a target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(settings.map_query) %>"><%= settings.address %></a></div>
          </div>
          <div class="info-row">
            <span class="info-icon">🕒</span>
            <div><strong>Opening hours</strong><span><%= settings.opening_hours %></span></div>
          </div>
        </div>
      </div>

      <div class="form-card">
        <span class="eyebrow">Send a message</span>
        <h2>We'd love to hear from you</h2>
        <form action="/contact" method="post">
          <div class="form-grid">
            <label>Your name<input name="name" required placeholder="Your full name"></label>
            <label>Phone number<input name="phone" placeholder="Optional" inputmode="tel"></label>
            <label class="full">Email address<input name="email" type="email" required placeholder="you@example.com"></label>
            <label class="full">Subject<input name="subject" placeholder="What is this about?"></label>
            <label class="full">Message<textarea name="message" rows="5" required placeholder="Tell us what's on your mind…"></textarea></label>
          </div>
          <div style="text-align:center"><button class="btn btn-primary" type="submit">Submit</button></div>
          <p class="form-hint">We usually reply within a few hours during kitchen hours.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
