  <div class="floating-contact" aria-label="Quick contact options">
    <a class="floating-btn floating-whatsapp" href="<%= whatsappLink(settings.phone) %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.52 0 .2 5.3.2 11.84c0 2.09.55 4.13 1.6 5.93L0 24l6.43-1.69a11.8 11.8 0 0 0 5.63 1.44h.01c6.54 0 11.86-5.3 11.86-11.84 0-3.16-1.23-6.14-3.41-8.43ZM12.06 21.9a9.84 9.84 0 0 1-5.02-1.38l-.36-.21-3.81 1 1.02-3.71-.24-.38a9.8 9.8 0 0 1-1.51-5.24c0-5.44 4.43-9.87 9.88-9.87a9.8 9.8 0 0 1 6.98 2.9 9.77 9.77 0 0 1 2.9 6.98c0 5.45-4.43 9.87-9.88 9.87Zm5.42-7.4c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.2 3.08c.15.2 2.08 3.17 5.04 4.45.71.3 1.26.48 1.69.62.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"/></svg>
    </a>
    <a class="floating-btn floating-mail" href="mailto:<%= settings.email %>" aria-label="Email us" title="Email us">
      <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
    </a>
  </div>

  <div class="cart-overlay" id="cart-overlay" hidden></div>
  <aside class="cart-drawer" id="cart-drawer" aria-hidden="true" aria-label="Shopping cart">
    <div class="cart-head">
      <div>
        <span class="eyebrow">Your order</span>
        <h2>Shopping cart</h2>
      </div>
      <button type="button" class="icon-btn" id="cart-close" aria-label="Close cart">×</button>
    </div>
    <div class="cart-body" id="cart-items"></div>
    <div class="cart-bottom">
      <div class="cart-totals">
        <div><span>Item total</span><strong id="cart-subtotal">₹0</strong></div>
        <div><span>Delivery</span><strong id="cart-delivery">₹0</strong></div>
        <div class="grand"><span>To pay</span><strong id="cart-total">₹0</strong></div>
      </div>
      <form id="checkout-form" class="checkout-form">
        <div class="form-row">
          <label>Your name<input name="name" required placeholder="e.g. Ananya Rao" autocomplete="name"></label>
          <label>Phone<input name="phone" required placeholder="10-digit mobile" inputmode="tel" autocomplete="tel"></label>
        </div>
        <label>Email (optional)<input name="email" type="email" placeholder="you@example.com" autocomplete="email"></label>
        <label>Delivery address<textarea name="address" required rows="2" placeholder="Flat, building, street, area" autocomplete="street-address"></textarea></label>
        <label>Notes for the kitchen (optional)<input name="notes" placeholder="e.g. less spicy, no onion"></label>
        <label class="select-label">Payment on delivery
          <select name="payment_method">
            <option value="cod">Cash on delivery</option>
            <option value="upi">UPI on delivery</option>
          </select>
        </label>
        <p class="form-error" id="checkout-error" hidden></p>
        <button class="btn btn-primary btn-block" type="submit" id="place-order-btn">Place order</button>
      </form>
    </div>
  </aside>

  <div class="modal" id="success-modal" hidden>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="success-title">
      <div class="success-icon">✓</div>
      <h2 id="success-title">Order placed!</h2>
      <p>Your food is being prepared fresh. We'll keep you posted.</p>
      <div class="order-pill-wrap">
        <div class="order-pill" id="success-order">CK-...</div>
        <button class="btn btn-sm btn-outline" type="button" id="copy-order-btn" aria-label="Copy tracking ID">Copy</button>
      </div>
      <p class="muted small">Estimated delivery: <strong id="success-eta">35 min</strong></p>
      <div class="modal-actions">
        <a class="btn btn-primary" id="success-track" href="#">Track order</a>
        <button class="btn btn-ghost" type="button" id="success-close">Keep browsing</button>
      </div>
    </div>
  </div>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <a class="brand brand-light" href="/">
          <img src="<%= settings.logo_url || '/cloudkitchen-icon.png' %>" alt="" class="brand-logo" aria-hidden="true">
          <span class="brand-text"><strong><%= settings.short_name %></strong></span>
        </a>
        <p><%= settings.tagline %> Made with care in our kitchen, packed hot and sent straight to your doorstep.</p>
        <div class="socials" aria-label="Social links">
          <a href="<%= settings.instagram %>" target="_blank" rel="noopener" aria-label="Instagram">ig</a>
          <a href="<%= whatsappLink(settings.phone) %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">WA</a>
          <a href="mailto:<%= settings.email %>" aria-label="Email">✉</a>
          <a href="tel:<%= settings.phone %>" aria-label="Phone">☎</a>
        </div>
      </div>
      <div>
        <h3>Explore</h3>
        <nav aria-label="Footer navigation">
          <ul class="footer-links">
            <li><a href="/menu">Full menu</a></li>
            <li><a href="/about">Our story</a></li>
            <li><a href="/contact">Contact us</a></li>
            <li><a href="/track">Track an order</a></li>
          </ul>
        </nav>
      </div>
      <div>
        <h3>Find us</h3>
        <ul class="footer-contact" aria-label="Kitchen contact details">
          <li><span>📍</span><%= settings.address %></li>
          <li><span>📞</span><a href="tel:<%= settings.phone %>"><%= settings.phone %></a></li>
          <li><span>✉️</span><a href="mailto:<%= settings.email %>"><%= settings.email %></a></li>
          <li><span>🕒</span><%= settings.opening_hours %></li>
        </ul>
      </div>
      <div class="footer-cta">
        <h3>Hungry now?</h3>
        <p>Skip the queue. Order fresh food in under a minute.</p>
        <a class="btn btn-primary" href="/menu">Order now →</a>
      </div>
    </div>
    <div class="container footer-bottom">
      <span>© <%= currentYear %> <%= settings.kitchen_name %>. All rights reserved.</span>
      <span>Made fresh, delivered with care.</span>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>

  <script src="/js/app.js" defer></script>
</body>
</html>
