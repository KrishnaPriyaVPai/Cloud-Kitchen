<%- include('partials/header') %>
<% const _portal = typeof portal !== 'undefined' ? portal : 'chef'; const _backHref = typeof backHref !== 'undefined' ? backHref : `/${_portal}/login`; %>

<div class="auth-wrap">
  <div class="auth-card">
    <span class="eyebrow">Account recovery</span>
    <h1>Reset password</h1>
    <p class="muted">Enter your account email and choose a new password.</p>
    <form action="/forgot-password" method="post">
      <input type="hidden" name="portal" value="<%= _portal %>">
      <label>Email address<input name="email" type="email" required autocomplete="username" placeholder="you@example.com"></label>
      <label style="margin-top:1rem">New password<input name="password" type="password" minlength="8" required autocomplete="new-password" placeholder="At least 8 characters"></label>
      <label style="margin-top:1rem">Confirm new password<input name="confirm_password" type="password" minlength="8" required autocomplete="new-password" placeholder="Re-enter password"></label>
      <button class="btn btn-primary btn-block" type="submit" style="margin-top:1.2rem">Update password →</button>
    </form>
    <p class="small muted" style="text-align:center;margin:1.2rem 0 0">
      <a class="link-arrow" href="<%= _backHref %>">Back to sign in →</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
